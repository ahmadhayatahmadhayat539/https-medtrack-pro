<!DOCTYPE html>
<html lang="ur">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MedTrack Pro</title>
<meta name="theme-color" content="#0d6efd">
<link rel="manifest" href="manifest.json">
<style>
*{box-sizing:border-box;font-family:system-ui,sans-serif}
body{margin:0;background:#f5f7fb;color:#222}
header{background:#0d6efd;color:#fff;padding:16px;text-align:center}
.card{background:#fff;margin:12px;padding:14px;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,.08)}
input,button{width:100%;padding:11px;margin:6px 0;border:1px solid #ccc;border-radius:8px;font-size:15px}
button{background:#0d6efd;color:#fff;border:none;font-weight:600}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
table{width:100%;border-collapse:collapse;margin-top:10px;font-size:14px}
th,td{border:1px solid #ddd;padding:8px;text-align:center}
th{background:#e9ecef}
</style>
</head>
<body>
<header><h1>💊 MedTrack Pro</h1></header>
<div class="card">
<h3>➕ نئی دوا شامل کریں</h3>
<input id="name" placeholder="دوا کا نام">
<input id="company" placeholder="کمپنی کا نام">
<div class="grid">
<input id="cost" type="number" placeholder="خرید قیمت (Rs)">
<input id="qty" type="number" placeholder="تعداد">
</div>
<input id="expiry" type="date">
<button onclick="add()">💾 محفوظ کریں</button>
</div>
<div class="card">
<h3>📋 سٹاک لسٹ</h3>
<button onclick="clearAll()" style="background:#dc3545">🗑️ سب ڈیلیٹ کریں</button>
<div style="overflow:auto">
<table><thead><tr><th>نام</th><th>کمپنی</th><th>خرید قیمت</th><th>تعداد</th><th>ایکسپائری</th><th>X</th></tr></thead><tbody id="list"></tbody></table>
</div>
</div>
<script>
let medicines = JSON.parse(localStorage.getItem('medtrack_simple_v1') || '[]');
function save(){ localStorage.setItem('medtrack_simple_v1', JSON.stringify(medicines)); render(); }
function add(){
 let n=document.getElementById('name').value.trim();
 let co=document.getElementById('company').value.trim();
 let c=document.getElementById('cost').value.trim();
 let q=document.getElementById('qty').value.trim();
 let e=document.getElementById('expiry').value;
 if(!n){ alert('دوا کا نام لکھیں'); return; }
 medicines.push({id:Date.now(), name:n, company:co, cost:c||'-', qty:q||'1', expiry:e||'-'});
 save();
 document.getElementById('name').value='';document.getElementById('company').value='';document.getElementById('cost').value='';document.getElementById('qty').value='';
}
function render(){
 let tbody=document.getElementById('list'); tbody.innerHTML='';
 medicines.forEach(m=>{
   let tr=document.createElement('tr');
   tr.innerHTML=`<td>${m.name}</td><td>${m.company}</td><td>${m.cost}</td><td>${m.qty}</td><td>${m.expiry}</td><td><button onclick="del(${m.id})" style="padding:4px 8px;background:#dc3545">X</button></td>`;
   tbody.appendChild(tr);
 });
}
function del(id){ medicines=medicines.filter(x=>x.id!==id); save(); }
function clearAll(){ if(confirm('سب ڈیلیٹ کرنا ہے؟')){ medicines=[]; save(); } }
render();
</script>
</body>
</html>
